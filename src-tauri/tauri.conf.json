{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lozkho Stereo",
  "version": "0.2.1",
  "identifier": "com.lozkho.stereo",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lozkho Stereo",
        "width": 420,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#000000",
        "theme": "Dark",
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Lozkho Stereo",
    "category": "Music",
    "shortDescription": "Estación de radio personal con música offline",
    "longDescription": "Lozkho Stereo simula una estación de radio. Reproduce tus archivos de música en bucle infinito, con letras sincronizadas, anuncios programados y emisoras personalizables. Funciona sin conexión a internet.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "MIT License",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {}
}
