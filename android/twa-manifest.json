{
  "packageId": "com.lozkho.stereo",
  "host": "lozkho.example.com",
  "name": "Lozkho Stereo",
  "launcherName": "Lozkho",
  "display": "standalone",
  "orientation": "default",
  "themeColor": "#000000",
  "themeColorDark": "#000000",
  "navigationColor": "#000000",
  "navigationColorDark": "#000000",
  "navigationDividerColor": "#000000",
  "navigationDividerColorDark": "#000000",
  "backgroundColor": "#000000",
  "enableNotifications": false,
  "startUrl": "./",
  "iconUrl": "./icon-512.png",
  "maskableIconUrl": "./icon-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "./android.keystore",
    "alias": "lozkho"
  },
  "appVersionName": "0.2.1",
  "appVersionCode": 1,
  "shortcuts": [
    { "name": "Emisora activa", "shortName": "Emisora", "url": "./?view=emisora" },
    { "name": "Lista de emisoras", "shortName": "Emisoras", "url": "./?view=emisoras" },
    { "name": "Letras", "shortName": "Letras", "url": "./?view=letras" }
  ],
  "generatorApp": "lozkho-stereo",
  "webManifestUrl": "./manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": { "enabled": false },
    "playBilling": { "enabled": false }
  },
  "alphaDependencies": { "enabled": false },
  "enableSiteSettingsShortcut": false,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "./",
  "minSdkVersion": 21,
  "_comment": "Para generar el APK: ver scripts/build-apk.sh. Requiere Node.js + Bubblewrap + Android SDK."
}
