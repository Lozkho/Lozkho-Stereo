<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lozkho.stereo">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Obligatorio desde API 34 declarar el tipo del foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar"
        android:usesCleartextTraffic="true">
        <!-- Sin screenOrientation fija: la app respeta la orientación del
             sistema (portrait/landscape/tablets) y la interfaz web es
             responsive. Los cambios de orientación no reinician la Activity
             (configChanges abajo). -->
        <activity
            android:name=".MainActivity"
            android:label="Lozkho Stereo"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Servicio de reproducción en primer plano: mantiene el proceso
             (y el WebView con el audio) vivo en background y expone la
             notificación de medios + MediaSession. -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Widget del home screen -->
        <receiver
            android:name=".StationWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.lozkho.stereo.action.widget.PREV_STATION" />
                <action android:name="com.lozkho.stereo.action.widget.NEXT_STATION" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/station_widget_info" />
        </receiver>
    </application>
</manifest>
